 <office:body>
  <office:text>
   <text:sequence-decls>
    <text:sequence-decl text:display-outline-level="0" text:name="Illustration"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Table"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Text"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Drawing"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Figure"/>
   </text:sequence-decls>
   <text:p text:style-name="P1">Motor<text:span text:style-name="T1">körning</text:span></text:p>
   <text:p text:style-name="P2">För körning av Titanias motor skall följande checklistor utföras. Avvikelser och frånsteg ska loggas i loggboken.</text:p>
   <text:h text:style-name="P3" text:outline-level="1">Motorkontroll</text:h>
   <text:p text:style-name="P4">Motorolja – Nivå<text:tab/>MELLAN MARKERINGAR</text:p>
   <text:p text:style-name="P4">Motorolja – Kvalité<text:tab/>KLAR el. HALVKLAR</text:p>
   <text:p text:style-name="P4">Kylvattenintagsventil<text:tab/>SJÖ (VÅGRÄT)</text:p>
   <text:p text:style-name="P4">Packboxolja<text:tab/>&gt;2 DM OVANFÖR VATTENLINJE</text:p>
   <text:p text:style-name="P5"><text:span text:style-name="T2">Backslags</text:span>olja – Nivå<text:tab/>MELLAN MARKERINGAR</text:p>
   <text:p text:style-name="P4"><text:span text:style-name="T2">Backslags</text:span>olja – Kvalité<text:tab/>KLAR</text:p>
   <text:p text:style-name="P6">Propelleraxel<text:tab/>KAN SNURRA FRITT</text:p>
   <text:p text:style-name="P4">Sjöintagsgenomföring<text:tab/>ÖPPEN (LODRÄT)</text:p>
   <text:p text:style-name="P4">Batterispänning<text:tab/>&gt;13,2 V</text:p>
   <text:p text:style-name="P7">Dieseltank<text:tab/>&gt;50 %</text:p>
   <text:p text:style-name="P8"><text:span text:style-name="T3"><text:tab/></text:span><text:span text:style-name="T4">Fara för luft i systemet vid &lt;20 %</text:span></text:p>
   <text:h text:style-name="P3" text:outline-level="1">Start</text:h>
   <text:p text:style-name="P4"><text:span text:style-name="T2">Ratt</text:span>utslag<text:tab/><text:span text:style-name="T5">FRITT </text:span><text:span text:style-name="T2">450</text:span><text:span text:style-name="T6">° </text:span><text:span text:style-name="T5">ÅT BÅDA SIDOR</text:span></text:p>
   <text:p text:style-name="P9">Motorstopphantag<text:tab/><text:span text:style-name="T5">INTRYCKT</text:span></text:p>
   <text:p text:style-name="P9">Gasreglage<text:tab/><text:span text:style-name="T5">FRILÄGE</text:span></text:p>
   <text:p text:style-name="P9">Sötvattenkylning<text:tab/><text:span text:style-name="T5">PÅ</text:span></text:p>
   <text:p text:style-name="P9">Tändning<text:tab/><text:span text:style-name="T5">PÅ</text:span></text:p>
   <text:p text:style-name="P10">Starta motorn med startknapp</text:p>
   <text:p text:style-name="P10">i sittbrunn eller motorrum</text:p>
   <text:h text:style-name="P11" text:outline-level="1">Under gång</text:h>
   <text:p text:style-name="P12"><text:span text:style-name="T5">Kylvatten</text:span><text:tab/><text:span text:style-name="T5">UT FRÅN AVGASRÖRET</text:span></text:p>
   <text:p text:style-name="P13">Länspump<text:tab/>VARJE 2,5 MIN<text:tab/>AUTO-KÖR</text:p>
   <text:p text:style-name="P14">Kylvattenlimpa<text:tab/><text:span text:style-name="T7">FÖRE</text:span> 5 MIN<text:tab/>&gt;<text:span text:style-name="T1">5</text:span><text:span text:style-name="T7">0 </text:span><text:span text:style-name="T8">°</text:span><text:span text:style-name="T9">C</text:span></text:p>
   <text:p text:style-name="P15">Packbox<text:tab/><text:span text:style-name="T10">EFTER 15 MIN<text:tab/></text:span>&lt;40 <text:span text:style-name="T11">°</text:span><text:span text:style-name="T10">C</text:span></text:p>
   <text:p text:style-name="P16">Batterispänning<text:tab/><text:span text:style-name="T7">FÖRE</text:span> 30 MIN<text:tab/>&gt;14,0 V</text:p>
  </office:text>
 </office:body>
</office:document>